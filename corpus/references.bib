% — Space psychology and long-duration human factors (appended by soviet-russian-heritage, 2026-05-03) —

@book{kanas2008space,
  author    = {Kanas, Nick and Manzey, Dietrich},
  title     = {Space Psychology and Psychiatry},
  edition   = {2},
  year      = {2008},
  publisher = {Springer and Microcosm Press},
  address   = {El Segundo, CA},
  note      = {Primary academic reference for cosmonaut and astronaut cognitive performance under isolation, long-duration missions, and high-workload supervisory conditions. Chapters 4--6 cover workload, performance degradation, and interpersonal dynamics relevant to far-side base crew design. Used in this study as the primary textbook reference for long-duration human factors and supervisory performance under isolation.}
}

@article{basner2013mars500,
  author    = {Basner, Mathias and Dinges, David F. and Mollicone, Daniel J. and Savelev, Igor and Ecker, Adrian J. and Di Antonio, Andrea and Jones, Christopher W. and Hyder, Eric C. and Kan, Kevin and Morukov, Boris V. and Sutton, Jeffrey P.},
  title     = {Mars 520-d Mission Simulation Reveals Protracted Crew Hypokinesis and Alterations of Sleep Duration and Timing},
  journal   = {Proceedings of the National Academy of Sciences},
  volume    = {110},
  number    = {7},
  pages     = {2635--2640},
  year      = {2013},
  doi       = {10.1073/pnas.1212646110},
  note      = {Primary behavioral health publication from the IBMP Mars-500 520-day isolation study. Key findings: reduced physical activity (hypokinesis) and altered sleep timing over the mission duration; performance on cognitive tasks (psychomotor vigilance) declined in the most sedentary crew members. Provides quantitative evidence of behavioral health degradation relevant to supervisory performance in long-duration far-side base operations. Used in this study to support the 6-month crew rotation cadence assumption.}
}

@misc{nasa_sma_spektr,
  author       = {{NASA Safety and Mission Assurance}},
  title        = {Mir-Progress Collision with {Spektr}: Significant Incident Analysis},
  howpublished = {NASA Safety and Mission Assurance, Safety Message, 8 November 2010},
  year         = {2010},
  note         = {Analysis of the June 25, 1997 Progress M-34 collision with the Spektr module during manual TORU docking by cosmonaut Vasily Tsibliev. Documents the transition from automated supervisory (Kurs) to direct teleoperation (TORU) and the factors contributing to failure: altered cargo ship center of gravity, lack of adequate simulator training. Used in this study as primary heritage for the risk of handoff from autonomous to direct teleoperation modes under unfamiliar system conditions. URL: https://sma.nasa.gov/docs/default-source/safety-messages/safetymessage-2010-11-08-mirprogresscollision-vits.pdf [To be confirmed against primary source before PDR].}
}
