  title        = {Development and Prospect of Chinese Lunar Relay Communication Satellite},
  journal      = {Space: Science \& Technology},
  year         = {2021},
  doi          = {10.34133/2021/3471608},
  note         = {Reviews Queqiao-1 (Earth-Moon L2 halo orbit relay, operational 2018--present) and development of Queqiao-2. Establishes technical rationale for elliptical frozen orbit over L2 halo orbit for multi-mission relay support. Used in this study for relay architecture context and dual-satellite constellation coverage estimates.}
}

