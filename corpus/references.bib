% — Lunokhod and surface telerobotics —

@misc{lroc_lunokhod2_traverse,
  author       = {Karachevtseva, I. P. and Basilevsky, A. T. and Oberst, J. and Zubarev, A. E. and Nadezhdina, I. E. and Kokhanov, A. A. and Garov, A. S.},
  title        = {The {Lunokhod-2} Geomorphological and Photogrammetric Mapping},
  howpublished = {Planetary and Space Science, 85, 175--187},
  year         = {2013},
  note         = {LRO LROC NAC photogrammetric analysis establishing Lunokhod 2 traverse distance as 39.16 km, superseding Soviet telemetry estimate of ~37 km. DOI: 10.1016/j.pss.2013.06.007 [to be confirmed against primary source before PDR]. Used in this study for the corrected Lunokhod 2 traverse distance and as primary heritage for 2.5-second round-trip teleoperation operations. The Lunokhod missions remain the only operational record of sustained surface teleoperation at lunar-distance latency.}
}

% — METERON and space teleoperation heritage (appended by teleoperation-latency, 2026-05-03) —

@inproceedings{meteron2015haptics2,
  author       = {Artigas, Jordi and De Martini, Davide and Riecke, Carsten and Preusche, Carsten and Birkenkampf, Philipp and Rott, Gerold and Lii, Neal},
  title        = {The {Haptics-2} Space Experiment: ISS to Earth Teleoperation with Time Delay via Bilateral Control},
  booktitle    = {Proceedings of the 13th Symposium on Advanced Space Technologies in Robotics and Automation (ASTRA)},
  year         = {2015},
  organization = {ESA},
  note         = {Demonstrates bilateral force-feedback teleoperation from ISS to Earth with ~820 ms round-trip latency. Key result: bilateral control is feasible at 820 ms using a geosynchronous satellite relay, establishing the performance floor for ISS-to-ground haptic teleoperation. Used in this study as the primary METERON heritage for the 800 ms–1 s latency tier. ESA METERON project deliverable.}
}

@article{schmaus2019suprvisjustin,
  author       = {Schmaus, Peter and Leidner, Daniel and Kr{\"o}ger, Torsten and Bauer, Andreas and Pleintinger, Benedikt and Schiele, Andre and Lii, Neal Y.},
  title        = {Knowledge Driven Orbit-to-Ground Teleoperation of a Robot Coworker},
  journal      = {IEEE Robotics and Automation Letters},
  volume       = {4},
  number       = {4},
  pages        = {4148--4155},
  year         = {2019},
  doi          = {10.1109/LRA.2019.2930130},
  note         = {METERON SUPVIS Justin experiment results. ISS astronaut commands DLR Rollin' Justin robot on Earth using a tablet PC; robot executes task autonomously. Key finding: task-level supervisory command (operator sets goals; robot executes) is robust to ISS-to-ground communication delay and jitter in a way that direct teleoperation is not. Used in this study as the primary evidence that supervisory control at 800 ms latency is viable where direct teleoperation is marginal.}
}

@inproceedings{meteron2019analog1,
  author       = {Schiele, Andre and Aiple, Manuel and Krueger, Thomas and van der Hulst, Frank and Kimmer, Stefan and Smisek, Jan and den Exter, Eddy},
  title        = {Haptics-2 and Analog-1: Preliminary Results from ESA's METERON Project},
  booktitle    = {Proceedings of the 15th Symposium on Advanced Space Technologies in Robotics and Automation (ASTRA)},
  year         = {2019},
  organization = {ESA},
  note         = {Summarizes Haptics-2 and Analog-1 experiments. Analog-1 (November 2019): ESA astronaut Luca Parmitano conducted geological sampling from ISS with ~850 ms communications latency using ESA's Interact rover at EAC, Cologne. Confirms feasibility of structured sampling tasks at ISS-to-ground latency. Used in this study as heritage for the 800 ms–1 s latency tier with supervisory/task-level commanding approach.}
}

@inproceedings{kontur2016forcefeedback,
  author       = {Riecke, Carsten and Artigas, Jordi and Birkenkampf, Philipp and Gonzalez-Gomez, Juan and Kr{\"o}ger, Torsten and Lii, Neal and Ott, Christian and Pleintinger, Benedikt and Schiele, Andre},
  title        = {{KONTUR-2}: Force-Feedback Teleoperation from the International Space Station},
  booktitle    = {2016 IEEE International Conference on Robotics and Automation (ICRA)},
  year         = {2016},
  pages        = {1166--1173},
  doi          = {10.1109/ICRA.2016.7487247},
  note         = {KONTUR-2 experiment: Russian cosmonaut teleoperated a force-feedback robot manipulator in Germany from ISS in August 2015 with ~800 ms round-trip latency. Key finding: haptic feedback improves performance in real-time teleoperation, but its benefit diminishes and can reverse at higher latencies; accuracy and trust improvements are lost at elevated latency. Used in this study to anchor the performance degradation curve at the 800 ms tier.}
}

% — Supervisory control theory (appended by teleoperation-latency, 2026-05-03) —

@techreport{sheridan1978teleoperators,
  author       = {Sheridan, Thomas B. and Verplank, William L.},
  title        = {Human and Computer Control of Undersea Teleoperators},
  institution  = {MIT Man-Machine Systems Laboratory},
  year         = {1978},
  number       = {MIT-SSL-TR},
  note         = {Seminal paper establishing the 10-level supervisory control taxonomy (Levels 1--10, from human does everything to computer acts entirely autonomously). The taxonomy is the foundational framework for analyzing human-automation allocation as a function of communication delay, task complexity, and automation capability. Used in this study as the theoretical mapping from latency tier to operational mode. The Sheridan-Verplank scale has been the dominant taxonomy in human-automation interaction research for over four decades.}
}

@book{sheridan2002humans,
  author       = {Sheridan, Thomas B.},
  title        = {Humans and Automation: System Design and Research Issues},
  year         = {2002},
  publisher    = {Wiley-Interscience and HFES},
  address      = {New York},
  note         = {Comprehensive treatment of supervisory control theory, teleoperation, and human-automation interaction. Chapter 5 discusses the taxonomy of supervisory control levels in the context of space teleoperation latency. Used in this study as the primary textbook reference for the Sheridan supervisory control framework cited throughout Section 02-02.}
}

% — Queqiao-2 relay satellite (appended by teleoperation-latency, 2026-05-03) —

@misc{cnsa2024queqiao2,
  author       = {{China National Space Administration}},
  title        = {Queqiao-2 Relay Satellite Mission},
  year         = {2024},
  howpublished = {CNSA official communications and mission announcements, March--April 2024},
  note         = {Queqiao-2 launched 20 March 2024; entered lunar orbit 24 March 2024; completed in-orbit communication tests with Chang'e-4 (far side) and Chang'e-6 (ground) by 12 April 2024. Orbital parameters: elliptical frozen orbit, periapsis ~200--250 km, apoapsis ~16,000--17,000 km above lunar surface, period ~24 hours, inclination 62.4 degrees. Designed to provide simultaneous line-of-sight to Earth and lunar far side for the majority of each orbital period. Used in this study for relay geometry and latency overhead calculations in Section 02-02.}
}

@article{spj2021lunarrelay,
