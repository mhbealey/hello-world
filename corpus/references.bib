@inproceedings{ono2018msl,
  author       = {Ono, Masahiro and Fuchs, Thomas J. and Steffy, Amanda and Maimone, Mark and Yen, Jeng},
  title        = {Risk-Aware Planetary Rover Operation: Autonomous Terrain Classification and Path Planning},
  booktitle    = {2015 IEEE Aerospace Conference},
  year         = {2015},
  doi          = {10.1109/AERO.2015.7119078},
  note         = {Describes AutoNav on Curiosity/MSL; stereo camera-based terrain classification and path planning for autonomous traverse. Used in this study as the primary flight heritage for deliberative path planning in an unstructured, communication-latency-constrained environment. AutoNav has been operational on Curiosity since 2012 and Perseverance since 2021 at traverse speeds up to 0.045 m/s. Directly analogous to the deliberative locomotion layer for the space humanoid.}
}

