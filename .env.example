# Required — app won't function without these
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token

# AI — one of these is required for recommendation generation
ANTHROPIC_API_KEY=sk-ant-...
# OR use the reversed key format:
# ANTHROPIC_KEY_REV=...reversed_key...

# Market data — Finnhub is primary, Yahoo Finance is fallback
FINNHUB_API_KEY=your_finnhub_key

# Macro data — optional, macro context will be empty without this
FRED_API_KEY=your_fred_key
