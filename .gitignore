# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials
.env
.env.local
.env*.local
.env.production
.env.staging

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local database
prisma/dev.db

# generated study site (rebuild with: python system/tools/build_site.py)
/site/
/studies/archive/*/site/
/studies/active/*/site/

# generated handback documents (regenerate with: python system/orchestration/handback.py)
# root-level leftovers from pre-restructure (safe to ignore)
handback-stage*.md

# generated CAD output (regenerate with: python system/tools/build_site.py)
/studies/archive/*/cad/output/
/studies/active/*/cad/output/

# archived study handbacks are tracked (override the handback-stage*.md pattern above)
!studies/archive/*/handbacks/*.md
