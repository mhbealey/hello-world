generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model UserProfile {
  id                        Int      @id @default(autoincrement())
  investing_style           String   // enum: growth, value, momentum, income
  risk_tolerance            Int      // 1-4
  instruments               String   // JSON array: stocks, etfs, options, crypto
  portfolio_size_range      String   // enum: 10k-25k, 25k-100k, 100k-500k, 500k+
  portfolio_balance         Float
  portfolio_balance_updated_at DateTime
  archetype                 String
  risk_score                Float
  asset_classes             String   @default("[\"stocks\"]") // JSON: stocks, debt, real_estate, physical, businesses

  // DDQ-derived fields — populated by the derivation engine after DDQ completion
  ddq_completed             Boolean  @default(false)
  ddq_completed_at          DateTime?
  ddq_version               Int      @default(0)           // tracks which DDQ version was completed

  // Investment objectives
  time_horizon              String?  // short_term, medium_term, long_term, multi_generational
  primary_goal              String?  // capital_appreciation, income_generation, capital_preservation, speculation, tax_optimization
  secondary_goals           String?  // JSON array of goals
  target_annual_return      Float?   // percentage
  liquidity_needs           String?  // none, low, moderate, high, critical
  withdrawal_timeline       String?  // none, 1_year, 3_years, 5_years, 10_plus

  // Risk profile (expanded)
  risk_capacity             Int?     // 1-10: financial ability to absorb losses
  risk_willingness          Int?     // 1-10: psychological comfort with volatility
  max_drawdown_tolerance    Float?   // percentage: max portfolio decline before panic
  loss_recovery_time        String?  // immediate_buy, wait_weeks, wait_months, exit_fully
  volatility_comfort        Int?     // 1-10: comfort with daily swings

  // Financial situation
  annual_income             String?  // bracket: under_50k, 50k_100k, 100k_250k, 250k_500k, 500k_plus
  net_worth_range           String?  // bracket: under_100k, 100k_500k, 500k_1m, 1m_5m, 5m_plus
  income_stability          String?  // stable_salary, variable_income, self_employed, retired, student
  debt_level                String?  // none, low, moderate, high
  emergency_fund_months     Int?     // 0-24+
  dependents                Int?     // number of financial dependents
  insurance_coverage        String?  // none, basic, comprehensive

  // Experience & knowledge
  years_investing           Int?     // 0-40+
  experience_level          String?  // beginner, intermediate, advanced, expert
  asset_classes_traded      String?  // JSON array: what they've actually traded
  derivatives_experience    String?  // none, basic_options, advanced_options, futures, swaps
  international_experience  Boolean? // traded non-US markets
  crypto_experience         String?  // none, holder, active_trader, defi_user

  // Allocation preferences
  equity_allocation         Float?   // target % in equities
  fixed_income_allocation   Float?   // target % in bonds/fixed income
  alternatives_allocation   Float?   // target % in alternatives (real estate, commodities, etc.)
  cash_allocation           Float?   // target % in cash
  crypto_allocation         Float?   // target % in crypto
  max_single_position       Float?   // max % in any single holding
  sector_concentration_limit Float?  // max % in any single sector

  // Sector & geographic preferences
  sector_preferences        String?  // JSON array of preferred sectors
  sector_exclusions         String?  // JSON array of excluded sectors
  geographic_preference     String?  // domestic_only, developed_markets, global, emerging_focus
  country_exclusions        String?  // JSON array of excluded countries/regions

  // ESG & values
  esg_importance            String?  // none, nice_to_have, important, mandatory
  esg_focus_areas           String?  // JSON array: environmental, social, governance, faith_based
  excluded_industries       String?  // JSON array: tobacco, weapons, gambling, fossil_fuels, alcohol, etc.
  impact_investing          Boolean? // interested in impact/social investing

  // Tax & legal
  tax_bracket               String?  // low, medium, high, highest
  account_types             String?  // JSON array: taxable, ira, roth_ira, 401k, hsa, trust
  tax_loss_harvesting       Boolean? // interested in TLH
  qualified_purchaser       Boolean? // accredited investor status
  restricted_securities     String?  // JSON array of tickers they can't trade (compliance)

  // Behavioral profile
  loss_aversion_score       Float?   // 1-10: how much losses hurt vs gains feel good
  overconfidence_score      Float?   // 1-10: tendency to overestimate own ability
  recency_bias_score        Float?   // 1-10: tendency to weight recent events too heavily
  herding_tendency          Float?   // 1-10: tendency to follow crowd
  anchoring_score           Float?   // 1-10: tendency to anchor to purchase price
  decision_speed            String?  // impulsive, quick, deliberate, slow, paralyzed
  information_preference    String?  // headlines, summaries, detailed_analysis, raw_data

  // Trading style
  holding_period            String?  // day_trade, swing, weeks, months, years, decades
  trading_frequency         String?  // daily, weekly, monthly, quarterly, rarely
  order_type_preference     String?  // market, limit, stop_limit, trailing_stop
  position_sizing_method    String?  // fixed_dollar, fixed_percent, kelly_criterion, equal_weight
  rebalancing_frequency     String?  // never, quarterly, semi_annual, annual, threshold_based
  stop_loss_discipline      String?  // never_use, sometimes, always, trailing

  // Income & yield
  dividend_preference       String?  // no_preference, dividend_growth, high_yield, reinvest_all
  income_target_pct         Float?   // target annual yield %
  preferred_payout          String?  // quarterly, monthly, no_preference

  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
}

model DdqResponse {
  id          Int      @id @default(autoincrement())
  section     String   // e.g., "investment_objectives"
  question_id String   @unique // e.g., "io_01"
  answer      String   // JSON-encoded answer
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([section])
}

model Recommendation {
  id                   Int      @id @default(autoincrement())
  ticker               String
  company_name         String
  asset_class          String   @default("stock") // stock, etf, bond, reit, commodity, business, real_estate, crypto
  ai_score             Float    // legacy 1-10
  benchmark_score      Int      @default(50) // 1-99 unified score
  previous_ai_score    Float?
  score_change_reason  String?
  rating               String   // enum: strong_buy, buy, hold, sell, strong_sell
  confidence           Float
  thesis               String
  bull_case            String   // JSON
  bear_case            String   // JSON
  key_metrics          String   // JSON
  factor_scores        String   // JSON — technical, fundamental, sentiment, momentum, earnings
  factor_details       String   // JSON
  governance_score     Float?   // board + CEO + M&A factor (1-10)
  governance_details   String?  // JSON: board_changes, ceo_changes, ma_activity
  position_size_pct    Float
  order_type           String
  entry_price          Float
  stop_loss            Float
  take_profit          Float
  time_sensitivity     String   // enum: act_today, this_week, monitor
  full_analysis        String
  catalysts            String   // JSON
  comparable_companies String   // JSON
  status               String   @default("active") // enum: active, executed, skipped, expired
  skipped_outcome_pct  Float?
  version              Int      @default(1)
  generated_at         DateTime @default(now())
  expires_at           DateTime
  bundle_id            Int?     // links to a BundlePortfolio

  trades       Trade[]
  wizardStates WizardState[]

  @@index([ticker, status])
  @@index([generated_at])
  @@index([asset_class, status])
  @@index([benchmark_score])
  @@index([bundle_id])
}

model Trade {
  id                Int       @id @default(autoincrement())
  recommendation_id Int?
  recommendation    Recommendation? @relation(fields: [recommendation_id], references: [id])
  parent_trade_id   Int?
  parent_trade      Trade?    @relation("PartialCloses", fields: [parent_trade_id], references: [id])
  child_trades      Trade[]   @relation("PartialCloses")
  ticker            String
  action            String    // enum: buy, sell
  shares            Float
  entry_price       Float
  stop_loss         Float?
  take_profit       Float?
  order_type        String
  status            String    @default("open") // enum: open, closed, cancelled
  exit_price        Float?
  exit_date         DateTime?
  return_pct        Float?
  return_dollars    Float?
  planned_rr_ratio  Float?
  actual_rr_ratio   Float?
  notes             String?
  source            String    // enum: ai_recommendation, manual
  created_at        DateTime  @default(now())

  @@index([ticker, status])
  @@index([created_at])
}

model WatchlistItem {
  id           Int      @id @default(autoincrement())
  ticker       String   @unique
  company_name String
  asset_class  String   @default("stock")
  added_at     DateTime @default(now())
  notes        String?

  @@index([ticker])
}

model PortfolioSnapshot {
  id               Int      @id @default(autoincrement())
  date             DateTime @unique
  total_value      Float
  daily_pnl        Float
  daily_pnl_pct    Float
  holdings_summary String   // JSON
  sp500_value      Float
  created_at       DateTime @default(now())

  @@index([date])
}

model WizardState {
  id                Int           @id @default(autoincrement())
  recommendation_id Int
  recommendation    Recommendation @relation(fields: [recommendation_id], references: [id])
  current_step      Int
  step_data         String        // JSON
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}

model AppSettings {
  key   String @id
  value String // JSON-encoded
}

model ApiUsage {
  id             Int      @id @default(autoincrement())
  date           DateTime
  call_count     Int
  estimated_cost Float
  created_at     DateTime @default(now())

  @@index([date])
}

model BundlePortfolio {
  id              Int      @id @default(autoincrement())
  name            String
  size            Int      // 1, 3, 5, 10, 20
  strategy        String   // growth, value, balanced, income, aggressive
  asset_filters   String   // JSON: { asset_classes, min_score, max_risk, sectors }
  total_score     Float    // weighted avg benchmark_score
  allocation      String   // JSON: [{ ticker, weight_pct, benchmark_score, asset_class }]
  rationale       String   // AI explanation
  status          String   @default("active") // active, archived
  generated_at    DateTime @default(now())

  @@index([status, size])
}
